# Copy to .env and fill in. .env is gitignored.

# ── Backend ───────────────────────────────────────────────────────────────────
# Shared secret the plugin and the Front playbook send as the X-Api-Key header.
API_KEY=ishida-demo-key-change-me
PORT=4000

# ── Plugin (Vite: only VITE_* vars reach the browser) ─────────────────────────
# Public HTTPS URL of the deployed backend. Falls back to http://localhost:4000.
VITE_BACKEND_URL=http://localhost:4000
# NOTE: this key ships inside the browser bundle. Acceptable for a fabricated-data
# demo only. See "Security note" in README.md for the production-shaped alternative.
VITE_API_KEY=ishida-demo-key-change-me

# ── Front setup scripts only (never read at runtime) ─────────────────────────
# Used by scripts/ to inspect or create custom fields in the demo instance.
FRONT_API_TOKEN=
